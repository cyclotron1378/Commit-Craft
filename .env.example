# GitSentry-AI Environment Configuration

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (gemini-2.5-flash recommended for speed & structured outputs)
GEMINI_MODEL=gemini-2.5-flash

# Optional: GitHub Personal Access Token (for private repo audits and PR comment posting)
GITHUB_TOKEN=your_github_token_here